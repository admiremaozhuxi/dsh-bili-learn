{
  "name": "dsh-bili-learn",
  "version": "0.2.5",
  "scripts": {
    "check": "node --check index.js && node --check lib/net.js && node --check lib/throttle.js && node --check client.js",
    "test": "npm run check && node test/throttle.test.mjs"
  },
  "type": "module",
  "license": "MIT",
  "author": "dsh-bili-learn contributors",
  "homepage": "https://github.com/admiremaozhuxi/dsh-bili-learn",
  "repository": {
    "type": "git",
    "url": "https://github.com/admiremaozhuxi/dsh-bili-learn",
    "directory": "plugin"
  },
  "keywords": [
    "dsh-plugin",
    "bilibili",
    "deepseek-harness",
    "subtitle",
    "asr",
    "video-understanding"
  ],
  "description": "Treat Bilibili as a research corpus: search high-view videos, harvest subtitles and comments, hand them to subagents for study.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  }
}
