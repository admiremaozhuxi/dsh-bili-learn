{
  "name": "@local/dsh-bili-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Treat Bilibili as a research corpus: search high-view videos, harvest subtitles and comments, hand them to subagents for study.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
